{
  "name": "attrash-online",
  "version": "1.0.0",
  "private": true,
  "description": "الأطرش أونلاين — منصة طلب وتوصيل لسلسلة محلات الأطرش (حلب). Built by Solunera.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push --force",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "drizzle-kit push --force && tsx src/db/seed.ts",
    "db:reset": "FORCE_SEED=1 tsx src/db/seed.ts",
    "images:pull": "tsx scripts/pull-images.ts",
    "db:setup:supabase": "drizzle-kit push --force && tsx src/db/seed.ts && tsx scripts/pull-images.ts",
    "db:local": "pglite-server --db=./.pglite --port=5433 --max-connections=10"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "^15.5.26",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "engines": {
    "node": ">=20"
  }
}
