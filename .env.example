# --- local development ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attrash"
AUTH_SECRET="replace-with-a-long-random-string-32+chars"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Render + Supabase ---
# DATABASE_URL: Supabase → Connect → "Session pooler" URI (IPv4, works from Render), with your DB password in it:
# DATABASE_URL="postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
# Photos and admin uploads go to Supabase Storage when these two are set (Render's disk is wiped on every deploy):
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: instant WhatsApp message to the owner for every new order (free: https://www.callmebot.com/blog/free-api-whatsapp-messages/)
CALLMEBOT_PHONE=""
CALLMEBOT_APIKEY=""

# --- docker compose (VPS) ---
# DB_PASSWORD="a-strong-password"
# SITE_URL="https://attrash-sy.com"
# SEED_DEMO=0   # 0 = only catalogue, no demo customers/orders
